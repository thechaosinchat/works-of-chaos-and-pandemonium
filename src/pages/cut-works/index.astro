---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const works = (await getCollection('cutWorks')).sort(
  (a, b) => b.data.cut.valueOf() - a.data.cut.valueOf()
);
const base = import.meta.env.BASE_URL;
const words = (body) => body
  .replace(/<[^>]*>/g, ' ')
  .replace(/[*_`~]/g, '')
  .trim()
  .split(/\s+/)
  .filter(Boolean)
  .length;
const date = (value) => value.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Cut Works — Works of Chaos and Pandemonium">
  <section class="archive">
    <div class="archive-label">Archive / Cut Works</div>
    <h1>Cut Works</h1>
    <p class="archive-intro">Pieces that were written, revised, and eventually cut from the living archive.</p>

    <div class="work-list">
      {works.map((work) => (
        <a class="work-item" href={`${base}cut-works/${work.id.replace(/\.md$/, '')}/`}>
          <div>
            <h2>{work.data.title}</h2>
            <div class="work-meta meta">
              <span>Created {date(work.data.created)}</span>
              <span>Edited {date(work.data.edited)}</span>
              <span>Cut / Archived {date(work.data.cut)}</span>
            </div>
            <div class="cut-note">
              <span class="cut-note-label">Why it was cut</span>
              {work.data.cutReason}
            </div>
          </div>
          <div class="word-count meta">{words(work.body)} words</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
