---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.created.valueOf() - a.data.created.valueOf()
);
const base = import.meta.env.BASE_URL;
const words = (body) => body
  .replace(/<[^>]*>/g, ' ')
  .replace(/[*_`~]/g, '')
  .trim()
  .split(/\s+/)
  .filter(Boolean)
  .length;
const date = (value) => value.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Works — Works of Chaos and Pandemonium">
  <section class="archive">
    <div class="archive-label">Archive / Works</div>
    <h1>Works</h1>
    <p class="archive-intro">Pieces that made it into the archive.</p>

    <div class="work-list">
      {works.map((work) => (
        <a class="work-item" href={`${base}works/${work.id.replace(/\.md$/, '')}/`}>
          <div>
            <h2>{work.data.title}</h2>
            <div class="work-meta meta">
              <span>Created {date(work.data.created)}</span>
              <span>Edited {date(work.data.edited)}</span>
            </div>
          </div>
          <div class="word-count meta">{words(work.body)} words</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
