---
interface Props {
  title?: string;
}

const { title = 'Works of Chaos and Pandemonium' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Works of Chaos and Pandemonium — a personal archive of journals, fragments, and cut works." />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={base}>Works of Chaos and Pandemonium</a>
      <nav aria-label="Main navigation">
        <a href={`${base}works/`}>Works</a>
        <a href={`${base}cut-works/`}>Cut Works</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>Works of Chaos and Pandemonium</span>
      <span>Personal archive</span>
    </footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Libre+Baskerville:wght@400;700&display=swap');

  :root {
    --paper: #f4f1ea;
    --ink: #181816;
    --muted: #77736b;
    --line: #cbc6bb;
    --accent: #6b3d32;
    --max: 920px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Libre Baskerville', Georgia, serif;
    line-height: 1.8;
  }

  a { color: inherit; }
  a:hover { color: var(--accent); }

  .site-header,
  .site-footer {
    width: min(calc(100% - 40px), var(--max));
    margin: 0 auto;
  }

  .site-header {
    min-height: 110px;
    padding: 32px 0 22px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }

  .site-title {
    font-size: 15px;
    line-height: 1.35;
    text-decoration: none;
    max-width: 270px;
  }

  nav { display: flex; gap: 24px; }
  nav a {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
    text-decoration: none;
  }

  main { width: min(calc(100% - 40px), var(--max)); margin: 0 auto; }

  .readme {
    max-width: 690px;
    padding: 100px 0 130px;
  }

  .eyebrow,
  .meta,
  .archive-label,
  .cut-note-label {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(38px, 7vw, 68px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -.035em;
    margin: 18px 0 45px;
  }

  h2 { font-size: 26px; line-height: 1.25; font-weight: 400; }
  p { margin: 0 0 1.4em; }

  .archive { padding: 72px 0 110px; }
  .archive h1 { font-size: clamp(40px, 7vw, 60px); margin-bottom: 18px; }
  .archive-intro { color: var(--muted); margin-bottom: 55px; max-width: 620px; }

  .work-list { border-top: 1px solid var(--line); }
  .work-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .work-item h2 { margin: 0 0 8px; }
  .work-item:hover h2 { color: var(--accent); }
  .work-meta { display: flex; flex-wrap: wrap; gap: 5px 14px; }
  .work-excerpt { color: var(--muted); font-size: 14px; margin: 12px 0 0; max-width: 680px; }
  .word-count { white-space: nowrap; padding-top: 6px; }

  .cut-note {
    margin-top: 18px;
    padding-left: 17px;
    border-left: 2px solid var(--accent);
    color: #514d46;
    font-size: 14px;
  }
  .cut-note-label { color: var(--accent); display: block; margin-bottom: 4px; }

  .article {
    max-width: 690px;
    padding: 85px 0 120px;
  }
  .article h1 { margin-bottom: 18px; font-size: clamp(38px, 6vw, 58px); }
  .article-meta { display: flex; flex-wrap: wrap; gap: 5px 15px; margin-bottom: 65px; }
  .article-content { font-size: 17px; }
  .article-content p { margin-bottom: 1.55em; }
  .article-content h2 { margin: 2em 0 .8em; }

  .article-cut {
    margin-bottom: 60px;
    padding: 20px 0 20px 18px;
    border-left: 2px solid var(--accent);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 22px 0 35px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .site-header { align-items: flex-start; flex-direction: column; }
    nav { gap: 18px; }
    .readme { padding: 65px 0 90px; }
    .archive, .article { padding-top: 55px; }
    .work-item { grid-template-columns: 1fr; gap: 2px; }
    .word-count { padding-top: 0; }
    .site-footer { flex-direction: column; }
  }
</style>
